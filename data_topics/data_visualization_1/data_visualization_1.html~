<span id="cb50-16"><a href="#cb50-16" aria-hidden="true" tabindex="-1"></a>plt.hist(data, color<span class="op">=</span><span class="st">'skyblue'</span>, edgecolor<span class="op">=</span><span class="st">'black'</span>)</span>
